<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The benchmark's ground truth. It reads a running app with plain FlaUI and does NOT reference any of
    WPF Locator Doctor's code, so its answers are an independent check on what the tool reports.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

</Project>
