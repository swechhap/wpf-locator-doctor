<!--
  Orders screen. Deliberately mixes good and bad practice. Each problem is labelled with the rule it should trigger.
-->
<Window x:Class="PracticeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PracticeApp.Controls"
        xmlns:views="clr-namespace:PracticeApp.Views"
        Title="Orders" Width="1000" Height="640"
        AutomationProperties.AutomationId="OrdersWindow">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File" AutomationProperties.AutomationId="FileMenu">
                <MenuItem Header="_Settings…" AutomationProperties.AutomationId="OpenSettingsMenuItem" Click="OpenSettings_Click" />
                <!-- WT001: no AutomationId -->
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
        </Menu>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Label Content="_Search:" Target="{Binding ElementName=SearchBox}" />
            <!-- WT002: ID borrowed from x:Name (its name comes from the label above, which is fine) -->
            <TextBox x:Name="SearchBox" Width="200" />
            <!-- GOOD -->
            <Button Content="Search" AutomationProperties.AutomationId="SearchButton" Margin="4,0" />
            <!-- WT003: generated-looking ID from x:Uid -->
            <Button x:Uid="Button_1" Content="Clear" Margin="4,0" />
            <!-- WT001 + WT008: icon-only button, no ID and no readable name -->
            <Button ToolTip="Refresh" Margin="4,0" Padding="6,2">
                <Path Data="M0,8 A8,8 0 1 1 8,16" Stroke="Black" StrokeThickness="2" />
            </Button>
            <!-- WT001 + WT008: no ID and no label -->
            <ComboBox Width="120" SelectedIndex="0" Margin="4,0">
                <ComboBoxItem>All</ComboBoxItem>
                <ComboBoxItem>Open</ComboBoxItem>
                <ComboBoxItem>Closed</ComboBoxItem>
            </ComboBox>
            <!-- GOOD -->
            <CheckBox Content="Only my orders" AutomationProperties.AutomationId="OnlyMineCheckBox" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <!-- WT004: the same ID used twice -->
            <Button Content="Delete" AutomationProperties.AutomationId="ActionButton" Margin="4,0" />
            <Button Content="Export" AutomationProperties.AutomationId="ActionButton" Margin="4,0" />
            <!-- GOOD -->
            <Button Content="Save" AutomationProperties.AutomationId="SaveButton" Margin="4,0" />
        </StackPanel>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- WT005: rows can't be told apart; and every row gets a "RemoveButton" (WT002 + rows problem) -->
            <ListBox x:Name="OrdersList" Grid.Column="0" AutomationProperties.Name="Recent orders">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button x:Name="RemoveButton" Content="Remove" DockPanel.Dock="Right" />
                            <TextBlock Text="{Binding OrderNumber}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TabControl Grid.Column="1" Margin="8,0,0,0" AutomationProperties.AutomationId="OrderTabs">
                <!-- GOOD -->
                <TabItem Header="Lines" AutomationProperties.AutomationId="LinesTab">
                    <!-- GOOD: rows get IDs from the keyed style in App.xaml -->
                    <DataGrid x:Name="OrdersGrid" AutomationProperties.AutomationId="OrdersGrid" AutomationProperties.Name="Order lines"
                              RowStyle="{StaticResource OrderRowStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Order" Binding="{Binding OrderNumber}" />
                            <DataGridTextColumn Header="Customer" Binding="{Binding Customer}" />
                            <DataGridTemplateColumn Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- WT001 (medium): no ID inside a row; rows are identifiable, so tests can still scope to the row -->
                                        <Button Content="View" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- WT001: tab without ID -->
                <TabItem Header="Details">
                    <StackPanel Margin="8">
                        <TextBlock Text="Customer rating" />
                        <!-- WT006: custom control with no automation peer: invisible to test tools, so its ID is lost -->
                        <local:StarRating AutomationProperties.AutomationId="CustomerRating" Height="24" />

                        <TextBlock Text="Delivery rating" Margin="0,8,0,0" />
                        <!-- GOOD: same kind of control, but it adds an automation peer -->
                        <local:AccessibleRating AutomationProperties.AutomationId="DeliveryRating" AutomationProperties.Name="Delivery rating" Height="24" />

                        <!-- WT007: ID on a panel that test tools can't see -->
                        <local:ColorSwatchPanel AutomationProperties.AutomationId="ColorSwatches" Margin="0,8,0,0">
                            <Rectangle Width="20" Height="20" Fill="Red" Margin="2" />
                            <Rectangle Width="20" Height="20" Fill="Green" Margin="2" />
                        </local:ColorSwatchPanel>

                        <views:AddressPanel AutomationProperties.AutomationId="ShippingAddress" Margin="0,8,0,0" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
