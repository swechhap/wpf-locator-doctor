<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The MCP server: gives AI assistants (Claude Code, VS Code / GitHub Copilot, Cursor…) tools to score a WPF
    project and fix its locators. It talks to the assistant over standard input/output (stdio).
    Every decision is made in WpfLocatorDoctor.Core; this project only describes the tools and starts the server.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WpfLocatorDoctor.Mcp</RootNamespace>
    <AssemblyName>wpf-locator-doctor-mcp</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WpfLocatorDoctor.Core\WpfLocatorDoctor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WpfLocatorDoctor.Mcp.Tests" />
  </ItemGroup>

</Project>
