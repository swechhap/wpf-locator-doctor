<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Built twice:
      net10.0          - runs anywhere; offers the XAML source scan only.
      net10.0-windows  - runs on Windows; adds the live-app scan (FlaUI).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <RootNamespace>WpfTestability.Cli</RootNamespace>
    <AssemblyName>wpf-testability</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wpf-testability</ToolCommandName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <DefineConstants>$(DefineConstants);LIVE_SCAN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WpfTestability.Core\WpfTestability.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\WpfTestability.Live\WpfTestability.Live.csproj" />
  </ItemGroup>

</Project>
