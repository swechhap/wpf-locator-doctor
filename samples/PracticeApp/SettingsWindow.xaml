<!--
  Settings screen. This one follows good practice throughout, so it should score an A.
-->
<Window x:Class="PracticeApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="420" Height="320"
        AutomationProperties.AutomationId="SettingsWindow">
    <StackPanel Margin="12">
        <Label Content="_Display name:" Target="{Binding ElementName=DisplayNameInput}" />
        <TextBox x:Name="DisplayNameInput" AutomationProperties.AutomationId="DisplayNameInput" />

        <GroupBox Header="Theme" Margin="0,12,0,0">
            <StackPanel>
                <RadioButton Content="Light" AutomationProperties.AutomationId="LightThemeOption" IsChecked="True" />
                <RadioButton Content="Dark" AutomationProperties.AutomationId="DarkThemeOption" />
            </StackPanel>
        </GroupBox>

        <Label Content="Font size:" Margin="0,12,0,0" />
        <Slider Minimum="10" Maximum="24" Value="14"
                AutomationProperties.AutomationId="FontSizeSlider"
                AutomationProperties.Name="Font size" />

        <CheckBox Content="Send me email updates" AutomationProperties.AutomationId="EmailUpdatesCheckBox" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" AutomationProperties.AutomationId="SettingsOkButton" IsDefault="True" Width="80" Click="Ok_Click" />
            <Button Content="Cancel" AutomationProperties.AutomationId="SettingsCancelButton" IsCancel="True" Width="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
