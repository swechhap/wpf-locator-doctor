<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs WPF Locator Doctor's own live scan, source scan and locator advice against an app that is already running,
    and writes what they report as JSON for benchmark/compare_live.py. Windows only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\WpfLocatorDoctor.Core\WpfLocatorDoctor.Core.csproj" />
    <ProjectReference Include="..\..\..\src\WpfLocatorDoctor.Live\WpfLocatorDoctor.Live.csproj" />
  </ItemGroup>

</Project>
