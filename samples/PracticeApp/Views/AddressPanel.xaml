<!--
  A reusable address section. IDs here are mostly borrowed from x:Name (WT002).
-->
<UserControl x:Class="PracticeApp.Views.AddressPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Label Content="Street:" Target="{Binding ElementName=StreetBox}" />
        <TextBox x:Name="StreetBox" Grid.Column="1" />

        <Label x:Name="CityLabel" Grid.Row="1" Content="City:" />
        <TextBox x:Name="CityBox" Grid.Row="1" Grid.Column="1"
                 AutomationProperties.LabeledBy="{Binding ElementName=CityLabel}" />

        <Label Grid.Row="2" Content="Postcode:" />
        <!-- GOOD ID, but WT008: the label isn't connected, so it has no readable name -->
        <TextBox Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="PostcodeInput" />
    </Grid>
</UserControl>
